# LanCast one-shot run configuration
# Override any value in your shell before running, or edit this file.

# Target device for flutter run (macos | windows | linux | chrome)
LANCAST_DEVICE=macos

# Auto-create a Viewer room on launch (true|false)
LANCAST_AUTO_ROOM=true

# Flutter SDK bin (leave empty to use PATH / common install locations)
# FLUTTER_BIN=/Applications/development/flutter/bin

# Extra flutter run args (optional)
# LANCAST_FLUTTER_ARGS=--verbose
